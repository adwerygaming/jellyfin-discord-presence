{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "es2022",
    "target": "es2023",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "apps/**/src"],
  "exclude": ["coverage", "dist", "docs", "node_modules"]
}
